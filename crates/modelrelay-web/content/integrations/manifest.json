      "name": "cURL",
      "description": "Quick test with curl",
      "template": "curl {{SERVER_URL}}/v1/chat/completions -H \"Content-Type: application/json\" -H \"Authorization: Bearer {{API_KEY}}\" -d '{{\"model\":\"{{MODEL_NAME}}\",\"messages\":[{{\"role\":\"user\",\"content\":\"Hello!\"}}]}}'",
      "verified": true
    },
    "python-openai": {
      "name": "Python OpenAI SDK",
      "description": "Use OpenAI SDK with ModelRelay",
      "template": "from openai import OpenAI\nclient = OpenAI(base_url=\"{{SERVER_URL}}/v1\", api_key=\"{{API_KEY}}\")\nresp = client.chat.completions.create(model=\"{{MODEL_NAME}}\", messages=[{\"role\":\"user\",\"content\":\"Hello!\"}])",
      "verified": true
    },
    "node-openai": {
      "name": "Node.js OpenAI SDK",
      "description": "Use OpenAI SDK in Node",
      "template": "import OpenAI from 'openai';\nconst client = new OpenAI({ baseURL: '{{SERVER_URL}}/v1', apiKey: '{{API_KEY}}' });\nconst resp = await client.chat.completions.create({ model: '{{MODEL_NAME}}', messages: [{role:'user',content:'Hello!'}] });",
      "verified": true
    },
    "openai-chat": {
      "name": "OpenAI Chat Completions",
      "description": "Standard OpenAI compatible endpoint",
      "template": "POST {{SERVER_URL}}/v1/chat/completions\nHeaders: Authorization: Bearer {{API_KEY}}\nBody: {\"model\":\"{{MODEL_NAME}}\",\"messages\":[{\"role\":\"user\",\"content\":\"Hello!\"}]}",
      "verified": true
    },
    "anthropic-messages": {
      "name": "Anthropic Messages",
      "description": "Anthropic compatible endpoint",
      "template": "POST {{SERVER_URL}}/v1/messages\nHeaders: x-api-key: {{API_KEY}}, anthropic-version: 2023-06-01\nBody: {\"model\":\"{{MODEL_NAME}}\",\"max_tokens\":1024,\"messages\":[{\"role\":\"user\",\"content\":\"Hello!\"}]}",
